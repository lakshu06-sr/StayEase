<% layout("layouts/boilerplate") %>
<section class="hero rounded-4 p-4 p-md-5 mb-5">
  <div class="row align-items-center">
    <div class="col-lg-8">
      <span class="badge bg-dark mb-3">StayEase</span>
      <h1 class="display-5 fw-bold">Find a stay you'll love.</h1>
      <p class="lead mb-0">Explore comfortable properties, view details and share your experience with reviews.</p>
    </div>
  </div>
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h3 mb-0">Explore properties</h2>
  <% if (currentUser) { %>
    <a class="btn btn-dark" href="/newplace"><i class="fa-solid fa-plus me-1"></i>Add property</a>
  <% } %>
</div>

<% if (!listings.length) { %>
  <div class="empty-state text-center p-5 rounded-4">
    <i class="fa-solid fa-house-chimney fa-2x mb-3"></i>
    <h3>No properties yet</h3>
    <p class="text-muted">Be the first person to add a property.</p>
    <% if (currentUser) { %>
      <a href="/newplace" class="btn btn-danger">Add the first property</a>
    <% } else { %>
      <a href="/signup" class="btn btn-danger">Create an account</a>
    <% } %>
  </div>
<% } else { %>
  <div class="row g-4">
    <% listings.forEach(listing => { %>
      <div class="col-12 col-sm-6 col-lg-4">
        <a href="/home/<%= listing._id %>" class="listing-link">
          <article class="card listing-card h-100 border-0 shadow-sm">
            <img src="<%= listing.image %>" class="card-img-top listing-image" alt="<%= listing.title %>" loading="lazy"
                 onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=80'">
            <div class="card-body">
              <h3 class="h5 card-title mb-1"><%= listing.title %></h3>
              <p class="text-muted mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
              <p class="mb-0"><strong>₹<%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
            </div>
          </article>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>
